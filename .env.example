APP_ORIGIN=http://localhost:3000
PORT=3000
DB_PATH=data/hrm.sqlite
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Used only by the explicit setup command. No default production credentials.
SETUP_EMAIL=
SETUP_PASSWORD=
SETUP_WORKSPACE=My Workspace
SETUP_COMPANY=My Company
# Explicit synthetic test seed only. Does not use DB_PATH as its target.
SEED_PASSWORD=
SEED_DB_PATH=data/seed.sqlite
# SEED_DATE=2026-10-11
# Optional runtime storage overrides. Railway uses its volume mount automatically.
# FILE_STORAGE_PATH=/data/files
# BACKUP_DIR=/data/backups
# Explicit first-run admin setup during startup (after the volume is mounted).
INITIAL_SETUP=false
