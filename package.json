{
  "name": "nexthrm1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun scripts/migrate.ts",
    "setup": "bun scripts/setup.ts",
    "verify": "bun run typecheck && bun test && bun run build",
    "db:backup": "bun scripts/backup.ts",
    "db:restore": "bun scripts/restore.ts",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src scripts tests",
    "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "playwright": "1.62.1",
    "prettier": "3.8.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
